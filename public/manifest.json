{
  "manifest_version": 3,
  "name": "SuperChrome",
  "description": "Raycast-style command palette for Chrome — bookmarks, tabs, history, and commands",
  "version": "0.26.1",
  "minimum_chrome_version": "114",
  "permissions": [
    "bookmarks",
    "favicon",
    "tabs",
    "scripting",
    "nativeMessaging",
    "storage",
    "history",
    "sessions",
    "tabGroups",
    "downloads",
    "downloads.open"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "_favicon/*",
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open SuperChrome palette",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "palette.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "omnibox": {
    "keyword": "b"
  },
  "commands": {
    "_execute_action": {
      "description": "Open palette (toolbar icon shortcut)"
    },
    "quick-open": {
      "description": "Open palette",
      "suggested_key": {
        "default": "Ctrl+P",
        "mac": "Command+P"
      }
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
