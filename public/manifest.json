{
  "manifest_version": 3,
  "name": "Code Panel",
  "description": "VSCode-style command palette for your bookmarks",
  "version": "0.5.0",
  "minimum_chrome_version": "114",
  "permissions": [
    "bookmarks",
    "favicon",
    "tabs",
    "scripting",
    "nativeMessaging",
    "storage",
    "history"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "_favicon/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open bookmark palette",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "palette.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "omnibox": {
    "keyword": "b"
  },
  "commands": {
    "_execute_action": {
      "description": "Open palette popup (works on chrome:// pages)"
    },
    "open-palette": {
      "description": "Open command palette",
      "suggested_key": {
        "default": "Ctrl+Shift+P",
        "mac": "Command+Shift+P"
      }
    },
    "quick-open": {
      "description": "Quick open bookmarks",
      "suggested_key": {
        "default": "Ctrl+P",
        "mac": "Command+P"
      }
    }
  }
}
